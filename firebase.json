{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "geocharge-f6714",
          "appId": "1:518875377655:android:384163f58a2e49fe45c8f2",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "geocharge-f6714",
          "configurations": {
            "android": "1:518875377655:android:384163f58a2e49fe45c8f2",
            "ios": "1:518875377655:ios:5854526050fe05e945c8f2",
            "macos": "1:518875377655:ios:5854526050fe05e945c8f2",
            "web": "1:518875377655:web:460e04cac1603f2545c8f2",
            "windows": "1:518875377655:web:6b55259ae644a3b245c8f2"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "site": "geocharge-f6714",
      "public": "admin/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/@(index.html|flutter_bootstrap.js|flutter.js|main.dart.js|flutter_service_worker.js|version.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "site": "geocharge-web",
      "public": "site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "uploads/geocharge-website-brief.md"
      ]
    },
    {
      "site": "geocharge-tesla",
      "public": "tesla",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}

rules_version = '2';

// GeoCharge Firestore security rules.
//
// Two audiences:
//   • The mobile app — each signed-in user reads/writes ONLY their own
//     users/{uid} document (profile, phone, premium flag, usage analytics).
//   • The admin panel (admin.geocharge.ge) — an allow-listed admin reads the
//     whole users collection (and manages the admin list).
//
// Admin membership is an entry in the `admins` collection keyed by the admin's
// email. The very first admin must be created by hand in the Firebase console
// (the rules below forbid writing `admins` unless you are already an admin, so
// the collection can't be bootstrapped from the client).
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the caller is a signed-in, allow-listed admin.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // ── User accounts ────────────────────────────────────────────────────────
    match /users/{uid} {
      // A user sees only their own document; an admin can read (and query/list)
      // every user for the panel.
      allow get:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Only the owner writes their own profile/analytics.
      allow write: if request.auth != null && request.auth.uid == uid;

      // Manual premium activation (admin panel): a user who paid by bank
      // transfer instead of an in-app purchase is granted premium by hand. An
      // allow-listed admin may therefore update ANY user document, but ONLY the
      // premium fields below — never a name, phone or usage counter. Expiry is
      // enforced server-side by the `expireManualPremium` scheduled function
      // (which uses the Admin SDK and bypasses these rules).
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'isPremium',
                           'premiumUntil',
                           'premiumSource',
                           'premiumPlan',
                           'premiumGrantedBy',
                           'premiumGrantedAt',
                           'premiumNote',
                           'premiumExpiredAt'
                         ]);

      // ── One-shot flags (tesla.geocharge.ge) ────────────────────────────────
      // The Tesla web app grants a 24h trial per ACCOUNT. The trial marker is
      // create-once: it must carry exactly a server-time `startedAt` and can
      // never be updated or deleted, so a user cannot reset their own trial
      // from the browser console — no server-side check is involved, this rule
      // is what makes the trial tamper-proof client-side.
      match /flags/{flag} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
                      && flag == 'teslaTrial'
                      && request.resource.data.keys().hasOnly(['startedAt'])
                      && request.resource.data.startedAt == request.time;
        // update/delete intentionally absent → denied.
      }

      // ── Car-side state (tesla.geocharge.ge) ────────────────────────────────
      // The driver's own saved places and routes, tied to the account rather
      // than to the car's browser storage so they survive a re-pair and follow
      // the account into another Tesla. Ordinary owner-only data: unlike the
      // trial flag above there is nothing here worth tamper-proofing — a user
      // rewriting their own favourites is exactly what the buttons do.
      //
      // Documents: `favourites` (up to four saved places), and later `routes`
      // plus `active` (a trip in progress, so it can be resumed).
      match /tesla/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // ── Charging expenses (mobile app) ─────────────────────────────────────
      // The driver's own cost log: one document per recorded charge, written
      // and read only by the account that owns it. Nothing here is aggregated
      // or shown to anyone else, admins included — it is somebody's household
      // spending, so the panel has no business reading it.
      match /expenses/{entry} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Admin allow-list ─────────────────────────────────────────────────────
    match /admins/{email} {
      // A signed-in user may read their OWN admin entry to learn whether they're
      // an admin (needed at panel login). Enumerating the whole list is admins-only.
      allow get:  if request.auth != null
                  && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();

      // Adding/removing admins is restricted to existing admins.
      allow write: if isAdmin();
    }

    // ── Revenue events ───────────────────────────────────────────────────────
    // One document per completed in-app purchase, written by the buyer's app
    // (id = the store transaction id, so retries are idempotent). Feeds the
    // admin panel's financial analytics.
    //
    // A signed-in user may create/merge ONLY their own purchase record (the
    // `uid` field must match their token); nobody but an admin can read the
    // collection, and no client can delete rows. Amounts come straight from the
    // store's ProductDetails, so a user can at most misreport their own row.
    //
    // An admin may also write rows for OTHER users: a manual (bank-transfer)
    // premium activation records its own revenue row (platform `manual`, no
    // store commission) so the Finance tab still reconciles to reality.
    match /purchases/{id} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
                    || (request.auth != null
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid);
      // delete intentionally absent → denied (revenue history is append-only).
    }

    // ── Tesla web app usage ──────────────────────────────────────────────────
    // One document per visit to tesla.geocharge.ge, written by the car itself
    // (tesla/js/usage.js) and read only by the admin panel: who was in a car,
    // when, and for how long. The driver may write rows that carry their own
    // uid and nothing else — including on update, so a row cannot be handed to
    // another account after the fact. Nobody deletes: the history is the point.
    match /teslaSessions/{id} {
      allow get, list: if isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      // delete intentionally absent → denied.
    }

    // ── Google Maps Platform usage ───────────────────────────────────────────
    // One document per day, written ONLY by the `pullMapsUsage` scheduled
    // function through the Admin SDK (which bypasses these rules), so that the
    // panel can show how much of the monthly free tier is left. No client
    // writes it and no client but an admin has any business reading it.
    match /mapsUsage/{day} {
      allow get, list: if isAdmin();
      // write intentionally absent → only the Admin SDK.
    }

    // ── Charger-free push alerts ─────────────────────────────────────────────
    // One doc per device, keyed by (a sanitized form of) the device's FCM token
    // — a secret bearer credential only that device knows. No login is required,
    // so alerts work for anonymous users too. The server-side gist updater reads
    // this collection with the Admin SDK (bypassing rules) to send the pushes.
    //
    // Writes are open (the token is the only thing tying a doc to a device, and
    // it isn't guessable) but must carry a string `token` field, which blocks
    // trivially malformed writes. The data here is low-value and disposable.
    match /charger_alerts/{token} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.token is string;
    }

    // Everything else is denied by default (no rule = no access).
  }
}

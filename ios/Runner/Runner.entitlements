<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required because the app offers Google sign-in (App Store Guideline 4.8).
	     Enable "Sign in with Apple" on the App ID in the Apple Developer portal,
	     and add this file under Runner target → Build Settings →
	     Code Signing Entitlements (CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Push Notifications (charger-freed-up alerts, via Firebase Cloud Messaging).
	     "production" matches Codemagic's release/App-Store build (the only iOS
	     build path this project uses — see codemagic.yaml). Also requires:
	       1. "Push Notifications" capability enabled on the ge.geocharge.app
	          App ID in the Apple Developer portal (Certificates, IDs & Profiles).
	       2. An APNs Auth Key uploaded in Firebase Console → Project Settings →
	          Cloud Messaging, so Firebase can actually deliver to APNs.
	     See docs/IOS_SETUP.md § Push Notifications. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
